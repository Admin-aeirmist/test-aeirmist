# ====================================================================
# Aeirmist Apache / InfinityFree Production Configuration (Cloudflare Safe)
# ====================================================================
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct pass-through for existing real files and assets
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Route all Single Page App (SPA) traffic to index.html
  RewriteRule ^ index.html [L]
</IfModule>

