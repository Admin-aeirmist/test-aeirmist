# ====================================================================
# Aeirmist Apache / InfinityFree Production Configuration & SEO Rules
# ====================================================================
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS Canonical Redirect (301)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?aeirmist\.com$ [NC]
  RewriteRule ^(.*)$ https://aeirmist.com/$1 [R=301,L]

  # 2. Enforce Non-WWW Canonical Redirect (301)
  RewriteCond %{HTTP_HOST} ^www\.aeirmist\.com$ [NC]
  RewriteRule ^(.*)$ https://aeirmist.com/$1 [R=301,L]

  # 3. Direct pass-through for existing real files and assets
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route all Single Page App (SPA) traffic to pre-rendered index.html
  RewriteRule ^ index.html [L]
</IfModule>

# MIME type declarations for SEO Crawlers
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/xml .xml
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# Caching directives for high performance Core Web Vitals
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|svg|webp|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
