# ==========================================
# Database & Cache (PostgreSQL 16 & Redis 7)
# ==========================================
POSTGRES_USER=aeirmist
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=aeirmist
DATABASE_URL=postgres://aeirmist:change_me_secure_password@127.0.0.1:5432/aeirmist
REDIS_URL=redis://127.0.0.1:6379

# ==========================================
# File & Media Storage (S3-Ready)
# ==========================================
STORAGE_DRIVER=local
STORAGE_PATH=./storage/uploads
PUBLIC_MEDIA_URL=http://localhost:4000/media
# For Cloudflare R2 / AWS S3 later:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=aeirmist-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ==========================================
# Server & Authentication
# ==========================================
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
JWT_SECRET=change_me_generate_random_secret_string
CORS_ORIGINS=http://localhost:5173,https://aeirmist.com,capacitor://localhost

# ==========================================
# Client (Vite Frontend)
# ==========================================
VITE_API_URL=http://localhost:4000
VITE_MEDIA_URL=http://localhost:4000/media

# Third-party Integrations (Optional)
GEMINI_API_KEY=
GIPHY_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=