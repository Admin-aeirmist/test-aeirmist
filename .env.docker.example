# ==============================================================================
# Aeirmist 24/7 Cloud Production Environment Template
# Copy this file to .env on your VPS and update the values:
#   cp .env.docker.example .env
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000
API_BASE_URL=https://aeirmist.com
PUBLIC_MEDIA_URL=https://aeirmist.com/media

# JWT Secret (generate a strong random string)
JWT_SECRET=aeirmist_production_ultra_secret_key_change_me_2026

# Allowed CORS Origins
CORS_ORIGINS=https://aeirmist.com,http://localhost:4000,http://localhost:5173,capacitor://localhost

# PostgreSQL Credentials
POSTGRES_USER=aeirmist
POSTGRES_PASSWORD=aeirmist_secure_password_2026
POSTGRES_DB=aeirmist

# Storage Driver ('local' or 's3')
STORAGE_DRIVER=local

# Cloudflare Tunnel Token (Optional but Recommended)
# If set, runs Cloudflare tunnel container to securely expose aeirmist.com
# without opening public ports on your VPS!
CLOUDFLARE_TUNNEL_TOKEN=
