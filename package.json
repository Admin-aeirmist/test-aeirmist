{
  "name": "remix-aeirmist-2-0",
  "private": true,
  "version": "2.0.0",
  "description": "A hyper-visual digital sanctuary for the next generation. Experience social media with main character energy through glassmorphic neon-futurism.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:pages": "vite build && node -e \"import('fs').then(fs => fs.copyFileSync('dist/index.html','dist/404.html'))\"",
    "build:native": "vite build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "sync": "node scripts/sync-repos.mjs",
    "deploy:infinityfree": "node scripts/deploy-infinityfree.mjs",
    "deploy:cloudflare": "npm run build && node scripts/deploy-cloudflare.mjs",
    "deploy": "npm run build && node scripts/deploy-cloudflare.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@google/genai": "^1.29.0",
    "@stripe/stripe-js": "^9.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express-session": "^1.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^4.19.1",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "glob": "^13.0.6",
    "helmet": "^8.2.0",
    "idb": "^8.0.3",
    "ioredis": "^5.11.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "playwright": "^1.61.1",
    "rate-limiter-flexible": "^11.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.15.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "recharts": "^3.8.1",
    "sharp": "^0.35.1",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "basic-ftp": "^6.2.1",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "@google/genai@1.52.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
