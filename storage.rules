rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // -- AUTH & IDENTITY HELPERS --
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        ('profile_' + request.auth.uid) == userId ||
        request.auth.uid == ('profile_' + userId)
      );
    }

    // Verify chat participant by checking Firestore conversation document
    function isChatParticipant(chatId) {
      return isSignedIn() && (
        (firestore.exists(/databases/(default)/documents/conversations/$(chatId)) && (
          request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(chatId)).data.participants ||
          ('profile_' + request.auth.uid) in firestore.get(/databases/(default)/documents/conversations/$(chatId)).data.participants
        )) ||
        (firestore.exists(/databases/(default)/documents/chats/$(chatId)) && (
          request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants ||
          ('profile_' + request.auth.uid) in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants
        ))
      );
    }

    // -- CONTENT VALIDATION HELPERS --
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 25 * 1024 * 1024; // Max 25MB
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size < 200 * 1024 * 1024; // Max 200MB
    }

    function isValidAudio() {
      return request.resource.contentType.matches('audio/.*')
        && request.resource.size < 50 * 1024 * 1024; // Max 50MB
    }

    function isValidDocument() {
      return (
        request.resource.contentType.matches('application/.*') ||
        request.resource.contentType.matches('text/.*')
      ) && request.resource.size < 50 * 1024 * 1024; // Max 50MB
    }

    function isValidMedia() {
      return isValidImage() || isValidVideo() || isValidAudio();
    }

    function isValidChatAttachment() {
      return isValidMedia() || isValidDocument();
    }

    // -- USER ISOLATED PATHS --
    
    // User root uploads (avatars, covers, wallpapers, stores, products under users/{uid}/...)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }
    
    // Specific avatar and profile picture paths - strictly owner-only write
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }
    
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }
    
    // Posts & Reels media uploaded by user - public read for web/SEO, owner-only write
    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }

    match /videos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidVideo();
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }

    match /notes/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }

    // Stores & Products media - public read, owner-only write
    match /stores/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }

    match /products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }

    // Private Vault files — strictly owner-only read AND write
    match /vault/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (
        isOwner(userId) ||
        request.auth.uid == userId ||
        ('profile_' + request.auth.uid) == userId ||
        request.auth.uid == ('profile_' + userId)
      );
      allow write: if isSignedIn() && (
        isOwner(userId) ||
        request.auth.uid == userId ||
        ('profile_' + request.auth.uid) == userId ||
        request.auth.uid == ('profile_' + userId)
      ) && (request.resource == null || request.resource.size < 250 * 1024 * 1024);
    }

    // Chat attachments — strictly participant-bound
    match /chats/{chatId}/{allPaths=**} {
      allow read: if isChatParticipant(chatId);
      allow write: if isChatParticipant(chatId) && isValidChatAttachment();
    }

    // Report/support attachments — user-scoped, owner writes, signed-in staff reads
    match /reports/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
    }

    match /supportTickets/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
    }

    match /supportReports/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
    }

    // Sound library — user-scoped audio and cover art
    match /sound-library/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidAudio();
    }

    match /sound-library-art/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    // Global wallpapers — user-scoped
    match /wallpapers/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    // Default deny for everything else (including root-level /vault or /chats without valid parameters)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
