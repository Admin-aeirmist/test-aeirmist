rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. GLOBAL SAFETY NET - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // -- PRIMITIVES & SECURITY HELPERS --
    // ==========================================
    function isSignedIn() { 
      return request.auth != null; 
    }

    // Tier 1: System Owner Identity (Strictly Verified Email)
    function isOwnerAccount() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == 'junaedislamjim180@gmail.com' ||
        request.auth.token.email == 'gateway_node@aeirmist.social'
      );
    }

    // Tier 2: Super Admin (System Owner or Super Admin claim)
    function isSuperAdmin() {
      return isSignedIn() && (
        isOwnerAccount() ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['owner', 'super_admin'])
      );
    }

    // Tier 3: General Administrator (Platform Admin, Custom Claim, or Admin Collection Record)
    function isAdmin() { 
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.admin == true ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['admin', 'administrator']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Tier 4: Content Moderator (Feed, Posts, Comments, Reports, Appeals)
    function isModerator() {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['moderator', 'content_moderator'])
      );
    }

    // Tier 5: Customer Support (User Help, Support Reports, Tickets)
    function isSupport() {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['support', 'customer_support'])
      );
    }

    // Tier 6: Marketplace Moderator (Stores, Products, Services, Orders)
    function isMarketplaceModerator() {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['marketplace_moderator'])
      );
    }

    function isOwner(userId) { 
      return request.auth != null && request.auth.uid == userId; 
    }

    function incoming() { 
      return request.resource.data; 
    }

    function existing() { 
      return resource.data; 
    }
    
    function isUserActive() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true &&
          (!get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['status']) ||
           !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ['BANNED', 'SUSPENDED', 'DELETED', 'banned', 'suspended', 'deleted']))
        )
      );
    }
    
    // -- RELATIONAL HELPERS --
    function isProfileOwnerRead(profileId) {
      return isSignedIn() && (
        profileId == 'profile_' + request.auth.uid ||
        profileId == request.auth.uid ||
        profileId.startsWith('profile_' + request.auth.uid) ||
        (exists(/databases/$(database)/documents/profiles/$(profileId)) && 
         (get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/profiles/$(profileId)).data.uid == request.auth.uid))
      );
    }

    function isProfileOwnerWrite(profileId) {
      return isSignedIn() && (
        profileId == 'profile_' + request.auth.uid ||
        profileId == request.auth.uid ||
        profileId.startsWith('profile_' + request.auth.uid) ||
        (exists(/databases/$(database)/documents/profiles/$(profileId)) && 
         (get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/profiles/$(profileId)).data.uid == request.auth.uid)) ||
        (existsAfter(/databases/$(database)/documents/profiles/$(profileId)) && 
         (getAfter(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid ||
          getAfter(/databases/$(database)/documents/profiles/$(profileId)).data.uid == request.auth.uid))
      );
    }

    function isFollowInteractionWrite(profileId) {
      return isSignedIn() && 
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['social', 'followersCount']) &&
             (resource.data.social == null || request.resource.data.social.diff(resource.data.social).affectedKeys().hasOnly(['followers']));
    }

    // Conversation Participant Authorization Helper
    function isConversationParticipant(conv) {
      return isSignedIn() && conv != null && (
        (conv.keys().hasAll(['participants']) && (
          request.auth.uid in conv.participants ||
          ('profile_' + request.auth.uid) in conv.participants
        )) ||
        (conv.keys().hasAll(['profileIds']) && (
          request.auth.uid in conv.profileIds ||
          ('profile_' + request.auth.uid) in conv.profileIds
        )) ||
        (conv.keys().hasAll(['otherParticipantId']) && (
          conv.otherParticipantId == request.auth.uid ||
          conv.otherParticipantId == ('profile_' + request.auth.uid)
        )) ||
        (conv.keys().hasAll(['otherParticipantUid']) && conv.otherParticipantUid == request.auth.uid) ||
        (conv.keys().hasAll(['ownerUid']) && conv.ownerUid == request.auth.uid) ||
        (conv.keys().hasAll(['buyerUid']) && conv.buyerUid == request.auth.uid) ||
        (conv.keys().hasAll(['sellerUid']) && conv.sellerUid == request.auth.uid) ||
        isAdmin()
      );
    }

    // Call Participant Helper
    function isCallParticipant(callDoc) {
      return isSignedIn() && callDoc != null && (
        request.auth.uid == callDoc.callerUid ||
        request.auth.uid == callDoc.receiverUid ||
        request.auth.uid == callDoc.initiatorId ||
        request.auth.uid == callDoc.targetId ||
        request.auth.uid == callDoc.callerId ||
        request.auth.uid == callDoc.receiverId ||
        ('profile_' + request.auth.uid) == callDoc.callerUid ||
        ('profile_' + request.auth.uid) == callDoc.receiverUid ||
        ('profile_' + request.auth.uid) == callDoc.callerId ||
        ('profile_' + request.auth.uid) == callDoc.receiverId ||
        (callDoc.keys().hasAll(['participants']) && (
          request.auth.uid in callDoc.participants ||
          ('profile_' + request.auth.uid) in callDoc.participants
        ))
      );
    }

    // Notification Recipient Helper
    function isNotificationRecipient(notif) {
      return isSignedIn() && notif != null && (
        notif.userId == request.auth.uid ||
        notif.userId == ('profile_' + request.auth.uid) ||
        (notif.keys().hasAll(['targetUid']) && notif.targetUid == request.auth.uid) ||
        (notif.keys().hasAll(['targetId']) && (notif.targetId == request.auth.uid || notif.targetId == ('profile_' + request.auth.uid))) ||
        (notif.keys().hasAll(['targetUserId']) && (notif.targetUserId == request.auth.uid || notif.targetUserId == ('profile_' + request.auth.uid))) ||
        (notif.keys().hasAll(['recipientUid']) && notif.recipientUid == request.auth.uid) ||
        isAdmin() ||
        isSupport()
      );
    }

    // Engagement Counter Integrity Helper
    function isValidCounterChange(fieldName) {
      return !incoming().keys().hasAll([fieldName]) || (
        incoming()[fieldName] is int && incoming()[fieldName] >= 0 && (
          !existing().keys().hasAll([fieldName]) ||
          incoming()[fieldName] == existing()[fieldName] ||
          incoming()[fieldName] == existing()[fieldName] + 1 ||
          incoming()[fieldName] == existing()[fieldName] - 1
        )
      );
    }

    function isValidEngagementUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'likes', 'likesCount', 'likedBy', 'bookmarks', 'bookmarksCount', 'savedBy', 
        'sharesCount', 'commentsCount', 'viewsCount', 'poll', 'updatedAt'
      ]) &&
      (!incoming().diff(existing()).affectedKeys().hasAny(['likesCount']) || isValidCounterChange('likesCount')) &&
      (!incoming().diff(existing()).affectedKeys().hasAny(['bookmarksCount']) || isValidCounterChange('bookmarksCount')) &&
      (!incoming().diff(existing()).affectedKeys().hasAny(['commentsCount']) || isValidCounterChange('commentsCount')) &&
      (!incoming().diff(existing()).affectedKeys().hasAny(['sharesCount']) || isValidCounterChange('sharesCount'));
    }

    // Notification Type Whitelist Helper
    function isAllowedNotificationType(type) {
      return type in [
        'like', 'comment', 'follow', 'follow_request', 'mention', 
        'message', 'repost', 'reaction', 'call', 'reply', 'gift', 
        'share', 'tag', 'security_new_device', 'verification_status', 
        'login_alert', 'system'
      ];
    }

    // ==========================================
    // -- COLLECTION RULES --
    // ==========================================
    
    // 1. USERS: Private account data. Read restricted to self, support, or admin; write to self/admin.
    // Prevents cross-user ID injection & identity field forgery.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupport());
      allow list: if isAdmin() || isSupport();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !request.resource.data.keys().hasAll(['uid']) || request.resource.data.uid == request.auth.uid
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny([
          'uid', 'createdAt', 'role', 'roles', 'isAdmin', 'isBanned', 'bannedAt', 'status', 'suspensionInfo', 'isVerified'
        ])) || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. PROFILES: Public social profile. Read authenticated; creation bound to auth UID;
    // updates prevent owner forgery; vault & settings strictly owner only.
    match /profiles/{profileId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (
        profileId in ['profile_' + request.auth.uid, request.auth.uid] &&
        (request.resource.data.ownerUid == request.auth.uid || request.resource.data.uid == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (isProfileOwnerWrite(profileId) && !incoming().diff(existing()).affectedKeys().hasAny([
          'ownerUid', 'uid', 'id', 'role', 'roles', 'isAdmin', 'isBanned', 'bannedAt', 'status', 'suspensionInfo', 'isVerified', 'badge'
        ])) || 
        isFollowInteractionWrite(profileId) || 
        isModerator()
      );
      allow delete: if isSignedIn() && (isProfileOwnerWrite(profileId) || isAdmin());
      
      match /vault/{vaultDoc} {
        allow read, write: if isSignedIn() && isProfileOwnerWrite(profileId);
      }

      match /settings/{settingsDoc} {
        allow read, write: if isSignedIn() && isProfileOwnerWrite(profileId);
      }
    }

    // 3. ADMINS & AUTHORIZATION: Super Admin only writes; self or admin reads
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /role_policies/{policyId} {
      allow read, write: if isSuperAdmin();
    }

    // 4. USERNAME INDEX: Unique registry, owned by claimant
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid || 
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        (resource != null && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid)) || 
        isAdmin()
      );
    }

    // 5. POSTS: Public read; create bound to authorUid; update/delete by author, interaction counters, or moderator
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isUserActive() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == ('profile_' + request.auth.uid) ||
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.authorId == ('profile_' + request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (
          (resource.data.authorUid == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid || resource.data.authorId == ('profile_' + request.auth.uid)) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['authorUid', 'userId', 'createdAt'])
        ) ||
        isValidEngagementUpdate() ||
        isModerator()
      );
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        resource.data.authorId == ('profile_' + request.auth.uid) ||
        isModerator()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isUserActive() && (
          request.resource.data.authorUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.authorId == ('profile_' + request.auth.uid)
        );
        allow update: if isSignedIn() && (
          (
            (resource.data.authorUid == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid || resource.data.authorId == ('profile_' + request.auth.uid)) &&
            !incoming().diff(existing()).affectedKeys().hasAny(['authorUid', 'userId', 'authorId', 'createdAt'])
          ) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount', 'likes']) ||
          isModerator()
        );
        allow delete: if isSignedIn() && (
          resource.data.authorUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.authorId == request.auth.uid ||
          resource.data.authorId == ('profile_' + request.auth.uid) ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid ||
          isModerator()
        );
      }
    }

    // 6. FEED POSTS: Public read; create bound to authorUid
    match /feed_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isUserActive() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        (
          (resource.data.authorUid == request.auth.uid || resource.data.userId == request.auth.uid) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['authorUid', 'userId', 'createdAt'])
        ) ||
        isValidEngagementUpdate() ||
        isModerator()
      );
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isModerator()
      );
    }

    // 7. POST INSIGHTS: Read restricted to post author or admin; updates restricted to viewer metrics; create verified author only
    match /post_insights/{postId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid ||
        get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.postId == postId && exists(/databases/$(database)/documents/posts/$(postId)) && (
        get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid ||
        get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['totalViews', 'viewSources', 'audience', 'profileClicks', 'lastUpdated']) ||
        get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (
        isSignedIn() && get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid
      );
    }

    // 8. POST VIEWS: User can only record view with their own viewerUid; no forge; author or admin reads; immutable
    match /post_views/{viewId} {
      allow create: if isSignedIn() && (
        request.resource.data.viewerUid == request.auth.uid ||
        request.resource.data.viewerId == request.auth.uid ||
        request.resource.data.viewerId == ('profile_' + request.auth.uid)
      ) && request.resource.data.keys().hasAll(['postId']) && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow read: if isSignedIn() && (
        resource == null || 
        get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorUid == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 9. FOLLOW REQUESTS: Sender-bound creation; participant-only get/list/update/delete
    match /follow_requests/{requestId} {
      allow get, list: if isSignedIn() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.fromId == ('profile_' + request.auth.uid) ||
        resource.data.toId == request.auth.uid ||
        resource.data.toId == ('profile_' + request.auth.uid) ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromProfileId == 'profile_' + request.auth.uid ||
        resource.data.toProfileId == 'profile_' + request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.fromId == request.auth.uid ||
        request.resource.data.fromId == ('profile_' + request.auth.uid) ||
        request.resource.data.fromUserId == request.auth.uid ||
        request.resource.data.fromProfileId == ('profile_' + request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.fromId == ('profile_' + request.auth.uid) ||
        resource.data.toId == request.auth.uid ||
        resource.data.toId == ('profile_' + request.auth.uid) ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromProfileId == 'profile_' + request.auth.uid ||
        resource.data.toProfileId == 'profile_' + request.auth.uid ||
        isAdmin()
      );
    }

    // 10. CONVERSATIONS & MESSAGES: Strict participant-only authorization; prevent hijacking
    match /conversations/{conversationId} {
      allow get, list: if isConversationParticipant(resource.data) || isAdmin();
      allow create: if isConversationParticipant(request.resource.data) || isAdmin();
      allow update: if isConversationParticipant(resource.data) || isAdmin();
      allow delete: if isConversationParticipant(resource.data) || isAdmin();

      match /messages/{messageId} {
        allow read: if isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) || isAdmin();
        allow create: if isUserActive() && (
          isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) ||
          isConversationParticipant(getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data)
        ) && (
          request.resource.data.senderId == request.auth.uid ||
          request.resource.data.senderId == 'profile_' + request.auth.uid ||
          request.resource.data.senderUid == request.auth.uid ||
          request.resource.data.senderId.startsWith(request.auth.uid)
        );
        allow update: if (
          (
            resource.data.senderId == request.auth.uid ||
            resource.data.senderId == 'profile_' + request.auth.uid ||
            resource.data.senderUid == request.auth.uid
          ) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['senderId', 'senderUid', 'createdAt'])
        ) || isAdmin();
        allow delete: if (
          resource.data.senderId == request.auth.uid ||
          resource.data.senderId == 'profile_' + request.auth.uid ||
          resource.data.senderUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 11. CHAT SETTINGS (Personal): Owner only
    match /chat_settings/{docId} {
      allow read, write: if isSignedIn() && (
        docId.startsWith(request.auth.uid) ||
        docId.startsWith('profile_' + request.auth.uid) ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid))
      );
    }
    
    // 12. SHARED CHAT SETTINGS: Conversation participants only
    match /shared_chat_settings/{chatId} {
      allow read: if isSignedIn() && (
        isConversationParticipant(get(/databases/$(database)/documents/conversations/$(chatId)).data) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        isConversationParticipant(get(/databases/$(database)/documents/conversations/$(chatId)).data) ||
        isAdmin()
      );
    }

    // Vault ownership helper — checks both raw uid AND profile_uid without Firestore document lookups
    // This is intentionally explicit to avoid cross-document read costs and timing issues on create.
    function isVaultOwnerData(uid) {
      return isSignedIn() && (
        uid == request.auth.uid ||
        uid == ('profile_' + request.auth.uid) ||
        ('profile_' + uid) == request.auth.uid
      );
    }

    // 13. VAULT FOLDERS: Owner only (supports both uid and profile_uid)
    match /vault_folders/{folderId} {
      allow read, update, delete: if isSignedIn() && (
        isVaultOwnerData(resource.data.userId) ||
        isVaultOwnerData(resource.data.ownerUid)
      );
      allow create: if isSignedIn() && (
        isVaultOwnerData(request.resource.data.userId) ||
        isVaultOwnerData(request.resource.data.ownerUid)
      );
    }

    // 13B. VAULT MEDIA: Owner only (supports both uid and profile_uid)
    match /vault_media/{mediaId} {
      allow read, update, delete: if isSignedIn() && (
        isVaultOwnerData(resource.data.userId) ||
        isVaultOwnerData(resource.data.ownerUid)
      );
      allow create: if isSignedIn() && (
        isVaultOwnerData(request.resource.data.userId) ||
        isVaultOwnerData(request.resource.data.ownerUid)
      );
    }


    // 14. CHAT NICKNAMES: Owner only
    match /chat_nickname/{docId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        resource.data.userId == ('profile_' + request.auth.uid) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == ('profile_' + request.auth.uid)))
      );
    }

    // 15. VIDEOS & STORIES: Author only write/delete; viewers update reactions
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn() && isUserActive() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.creatorUid == request.auth.uid ||
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.creatorId == ('profile_' + request.auth.uid) ||
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.authorId == ('profile_' + request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (
          (resource.data.authorUid == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.creatorId == request.auth.uid || resource.data.creatorId == ('profile_' + request.auth.uid)) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['authorUid', 'userId', 'createdAt'])
        ) ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'likes', 'likeCount', 'likedBy', 'views', 'viewCount', 'sharesCount', 'shareCount', 'saveCount', 'savedBy', 'commentCount', 'commentsCount', 'comments'
        ]) ||
        isModerator()
      );
      allow delete: if isSignedIn() && (existing().authorUid == request.auth.uid || existing().userId == request.auth.uid || existing().creatorId == request.auth.uid || existing().creatorId == ('profile_' + request.auth.uid) || isModerator());
    }
    
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && isUserActive() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.authorId == ('profile_' + request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (
          (resource.data.authorUid == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid || resource.data.authorId == ('profile_' + request.auth.uid)) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['authorUid', 'userId', 'createdAt'])
        ) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['viewers', 'reactions']) ||
        isModerator()
      );
      allow delete: if isSignedIn() && (
        existing().authorUid == request.auth.uid ||
        existing().userId == request.auth.uid ||
        existing().authorId == request.auth.uid ||
        existing().authorId == ('profile_' + request.auth.uid) ||
        isModerator()
      );
    }

    // 16. NOTIFICATIONS: Strict recipient get and list authorization; sender-bound creation
    match /notifications/{notifId} {
      allow get, list: if isNotificationRecipient(resource.data);
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          (!request.resource.data.keys().hasAll(['type']) || isAllowedNotificationType(request.resource.data.type)) &&
          (
            request.resource.data.userId == request.auth.uid ||
            request.resource.data.userId == ('profile_' + request.auth.uid) ||
            request.resource.data.fromUserUid == request.auth.uid ||
            request.resource.data.fromUserId == request.auth.uid ||
            request.resource.data.fromUserId == ('profile_' + request.auth.uid) ||
            (request.resource.data.keys().hasAll(['senderId']) && request.resource.data.senderId == request.auth.uid)
          )
        )
      );
      allow update, delete: if isNotificationRecipient(resource.data);
    }

    // 17. CALLS & CANDIDATES: Strict participant get and list authorization
    match /calls/{callId} {
      allow get, list: if isCallParticipant(resource.data) || isAdmin();
      allow create: if isSignedIn() && (
        request.resource.data.callerUid == request.auth.uid ||
        request.resource.data.initiatorId == request.auth.uid ||
        (request.resource.data.keys().hasAll(['participants']) && (
          request.auth.uid in request.resource.data.participants ||
          ('profile_' + request.auth.uid) in request.resource.data.participants
        ))
      );
      allow update: if isCallParticipant(resource.data) || isAdmin();
      allow delete: if (resource.data.initiatorId == request.auth.uid || resource.data.callerUid == request.auth.uid || isAdmin());

      match /candidates/{candId} {
        allow read, write: if isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data) || isAdmin();
      }

      match /signaling/{docId} {
        allow read, write: if isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data) || isAdmin();
      }
    }

    // 18. CALL HISTORY: Strict participant get and list authorization
    match /callHistory/{recordId} {
      allow get, list: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        ('profile_' + request.auth.uid) in resource.data.participants ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participants ||
        ('profile_' + request.auth.uid) in request.resource.data.participants
      );
      allow update, delete: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        ('profile_' + request.auth.uid) in resource.data.participants ||
        isAdmin()
      );
    }
    
    // 19. ACCOUNTS: Owner only
    match /accounts/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
    
    // 20. NOTES: Public read; author only update/delete
    match /notes/{noteId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.authorId == 'profile_' + request.auth.uid
      );
      allow update: if isSignedIn() && (
        existing().authorUid == request.auth.uid ||
        existing().authorId == request.auth.uid ||
        existing().authorId == 'profile_' + request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['seenBy', 'reactions']) ||
        isModerator()
      );
      allow delete: if isSignedIn() && (
        existing().authorUid == request.auth.uid || 
        existing().authorId == request.auth.uid || 
        existing().authorId == 'profile_' + request.auth.uid ||
        isModerator()
      );
    }
    
    // 21. HIGHLIGHTS: Public read; author only
    match /highlights/{highlightId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isModerator()
      );
    }
    
    // 22. SONGS: Public read; admin write
    match /songs/{songId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 23. NGL MESSAGES: Recipient only read & manage; signed in send
    match /ngl_messages/{msgId} {
      allow get, list: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid || 
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientProfileId == ('profile_' + request.auth.uid)
      );
      allow create: if isSignedIn() && 
        incoming().status == 'unread' && 
        incoming().content.size() <= 300 &&
        incoming().createdAt == request.time;
      allow update: if isSignedIn() && (
        existing().recipientUid == request.auth.uid ||
        existing().recipientId == request.auth.uid ||
        existing().recipientProfileId == ('profile_' + request.auth.uid)
      ) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'storyReplyId', 'repliedAt']);
      allow delete: if isSignedIn() && (
        existing().recipientUid == request.auth.uid || 
        existing().recipientId == request.auth.uid ||
        existing().recipientProfileId == ('profile_' + request.auth.uid) ||
        isModerator()
      );
    }

    // 24. TYPING INDICATORS: Strictly conversation participant / owner only
    match /typing_indicators/{indicatorId} {
      allow read, write: if isSignedIn() && (
        indicatorId.contains(request.auth.uid) ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid))
      );
    }

    // 25. MARKETPLACE STORES: Public read; owner or marketplace moderator write
    match /stores/{storeId} {
      allow read: if resource == null || 
                     resource.data.status == 'active' || 
                     !resource.data.keys().hasAll(['status']) ||
                     (isSignedIn() && (
                       resource.data.ownerId == request.auth.uid || 
                       resource.data.ownerUid == request.auth.uid || 
                       resource.data.ownerId == ('profile_' + request.auth.uid) ||
                       resource.data.ownerUid == ('profile_' + request.auth.uid) ||
                       isMarketplaceModerator()
                     ));
      allow create: if isSignedIn() && (
        request.resource.data.ownerId == request.auth.uid || 
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerId == ('profile_' + request.auth.uid) ||
        request.resource.data.ownerUid == ('profile_' + request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (
          (resource.data.ownerId == request.auth.uid || resource.data.ownerUid == request.auth.uid || resource.data.ownerId == ('profile_' + request.auth.uid) || resource.data.ownerUid == ('profile_' + request.auth.uid)) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['ownerId', 'ownerUid', 'createdAt'])
        ) || 
        isMarketplaceModerator()
      );
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        resource.data.ownerUid == request.auth.uid || 
        resource.data.ownerId == ('profile_' + request.auth.uid) ||
        resource.data.ownerUid == ('profile_' + request.auth.uid) ||
        isMarketplaceModerator()
      );
    }

    // 26. MARKETPLACE PRODUCTS: Public read; seller/owner or marketplace moderator write
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerUid == request.auth.uid || 
        request.resource.data.sellerId == request.auth.uid || 
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.sellerUid == ('profile_' + request.auth.uid) ||
        request.resource.data.sellerId == ('profile_' + request.auth.uid) ||
        request.resource.data.ownerUid == ('profile_' + request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (
          (resource.data.sellerUid == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.ownerUid == request.auth.uid || resource.data.sellerUid == ('profile_' + request.auth.uid) || resource.data.sellerId == ('profile_' + request.auth.uid) || resource.data.ownerUid == ('profile_' + request.auth.uid)) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['sellerUid', 'sellerId', 'ownerUid', 'createdAt'])
        ) ||
        isMarketplaceModerator()
      );
      allow delete: if isSignedIn() && (
        resource.data.sellerUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        resource.data.ownerUid == request.auth.uid || 
        resource.data.sellerUid == ('profile_' + request.auth.uid) || 
        resource.data.sellerId == ('profile_' + request.auth.uid) || 
        resource.data.ownerUid == ('profile_' + request.auth.uid) || 
        isMarketplaceModerator()
      );
    }

    // 27. MARKETPLACE SERVICES: Public read; seller/owner or marketplace moderator write
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerUid == request.auth.uid || 
        request.resource.data.sellerId == request.auth.uid || 
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == ('profile_' + request.auth.uid) ||
        request.resource.data.sellerId == ('profile_' + request.auth.uid) ||
        request.resource.data.sellerUid == ('profile_' + request.auth.uid) ||
        request.resource.data.ownerUid == ('profile_' + request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (
          (resource.data.sellerUid == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.ownerUid == request.auth.uid || resource.data.ownerId == request.auth.uid || resource.data.ownerId == ('profile_' + request.auth.uid)) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['sellerUid', 'sellerId', 'ownerUid', 'ownerId', 'createdAt'])
        ) ||
        isMarketplaceModerator()
      );
      allow delete: if isSignedIn() && (
        resource.data.sellerUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        resource.data.ownerUid == request.auth.uid || 
        resource.data.ownerId == request.auth.uid || 
        resource.data.ownerId == ('profile_' + request.auth.uid) || 
        isMarketplaceModerator()
      );
    }

    // 28. MARKETPLACE STORE POSTS: Public read; store owner or marketplace moderator write
    match /store_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.sellerUid == request.auth.uid ||
        request.resource.data.ownerUid == ('profile_' + request.auth.uid) ||
        request.resource.data.sellerUid == ('profile_' + request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        resource.data.ownerUid == ('profile_' + request.auth.uid) ||
        resource.data.sellerUid == ('profile_' + request.auth.uid) ||
        isMarketplaceModerator()
      );
    }

    // 29. MARKETPLACE STORE CHATS: Buyer, seller, or participants get and list authorization
    match /store_chats/{chatId} {
      allow get, list: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        resource.data.buyerUid == ('profile_' + request.auth.uid) ||
        resource.data.sellerUid == ('profile_' + request.auth.uid) ||
        resource.data.customerId == request.auth.uid ||
        resource.data.customerId == ('profile_' + request.auth.uid) ||
        resource.data.storeOwnerId == request.auth.uid ||
        resource.data.storeOwnerId == ('profile_' + request.auth.uid) ||
        (resource.data.keys().hasAll(['participants']) && (request.auth.uid in resource.data.participants || ('profile_' + request.auth.uid) in resource.data.participants)) ||
        isMarketplaceModerator()
      );
      allow create: if isSignedIn() && (
        request.resource.data.buyerUid == request.auth.uid ||
        request.resource.data.sellerUid == request.auth.uid ||
        request.resource.data.buyerUid == ('profile_' + request.auth.uid) ||
        request.resource.data.sellerUid == ('profile_' + request.auth.uid) ||
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.customerId == ('profile_' + request.auth.uid) ||
        request.resource.data.storeOwnerId == request.auth.uid ||
        request.resource.data.storeOwnerId == ('profile_' + request.auth.uid) ||
        (request.resource.data.keys().hasAll(['participants']) && (request.auth.uid in request.resource.data.participants || ('profile_' + request.auth.uid) in request.resource.data.participants)) ||
        isMarketplaceModerator()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        resource.data.buyerUid == ('profile_' + request.auth.uid) ||
        resource.data.sellerUid == ('profile_' + request.auth.uid) ||
        resource.data.customerId == request.auth.uid ||
        resource.data.customerId == ('profile_' + request.auth.uid) ||
        resource.data.storeOwnerId == request.auth.uid ||
        resource.data.storeOwnerId == ('profile_' + request.auth.uid) ||
        (resource.data.keys().hasAll(['participants']) && (request.auth.uid in resource.data.participants || ('profile_' + request.auth.uid) in resource.data.participants)) ||
        isMarketplaceModerator()
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/store_chats/$(chatId)).data.buyerUid == request.auth.uid ||
          get(/databases/$(database)/documents/store_chats/$(chatId)).data.sellerUid == request.auth.uid ||
          get(/databases/$(database)/documents/store_chats/$(chatId)).data.buyerUid == ('profile_' + request.auth.uid) ||
          get(/databases/$(database)/documents/store_chats/$(chatId)).data.sellerUid == ('profile_' + request.auth.uid) ||
          get(/databases/$(database)/documents/store_chats/$(chatId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/store_chats/$(chatId)).data.customerId == ('profile_' + request.auth.uid) ||
          request.auth.uid in get(/databases/$(database)/documents/store_chats/$(chatId)).data.participants ||
          ('profile_' + request.auth.uid) in get(/databases/$(database)/documents/store_chats/$(chatId)).data.participants ||
          isMarketplaceModerator()
        );
      }
    }

    // 30. FEED COMMENTS: Public read; author or moderator write; interactions
    match /feed_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isUserActive() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.authorId == ('profile_' + request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (
          (resource.data.authorUid == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid || resource.data.authorId == ('profile_' + request.auth.uid)) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['authorUid', 'userId', 'authorId', 'createdAt'])
        ) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount', 'likes']) ||
        isModerator()
      );
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        resource.data.authorId == ('profile_' + request.auth.uid) ||
        isModerator()
      );
    }

    // 30B. VIDEO COMMENTS: Public read; author or moderator write; interactions
    match /video_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isUserActive() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == ('profile_' + request.auth.uid) ||
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.profileId == ('profile_' + request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (
          (resource.data.userId == request.auth.uid || resource.data.userId == ('profile_' + request.auth.uid) || resource.data.authorUid == request.auth.uid) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['userId', 'videoId', 'createdAt'])
        ) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likeCount', 'likedBy', 'isPinned', 'isHearted', 'replies']) ||
        isModerator()
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == ('profile_' + request.auth.uid) ||
        resource.data.authorUid == request.auth.uid ||
        isModerator()
      );
    }

    // 31. MARKETPLACE STORE REVIEWS: Public read; author or marketplace moderator write
    match /store_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isMarketplaceModerator()
      );
    }

    // 32. MARKETPLACE SAVED ITEMS: User owner only (supports uid and profile_uid)
    match /saved_items/{itemId} {
      allow read: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid ||
        resource.data.userId == ('profile_' + request.auth.uid)
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == ('profile_' + request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == ('profile_' + request.auth.uid)
      );
    }

    // 33. BILLING TRANSACTIONS: User owner or admin only
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 34. ACTIVITIES: User owner only (supports userId and profileId)
    match /activities/{activityId} {
      allow read, update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == ('profile_' + request.auth.uid) ||
        resource.data.profileId == request.auth.uid ||
        resource.data.profileId == ('profile_' + request.auth.uid) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == ('profile_' + request.auth.uid) ||
        request.resource.data.profileId == request.auth.uid ||
        request.resource.data.profileId == ('profile_' + request.auth.uid)
      );
    }

    // 35. SOUND LIBRARY: Public read; uploader-bound creation; uploader or admin write
    match /sound_library/{trackId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.uploaderUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        (resource.data.uploaderUid == request.auth.uid && !incoming().diff(existing()).affectedKeys().hasAny(['uploaderUid', 'createdAt'])) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['usageCount']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.uploaderUid == request.auth.uid || isAdmin());
    }

    // 36. MARKETPLACE ORDERS: Buyer, seller, or marketplace moderator with strict field protections
    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.buyerId == ('profile_' + request.auth.uid) ||
        resource.data.sellerUid == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.sellerId == ('profile_' + request.auth.uid) ||
        (resource.data.keys().hasAll(['sellerUids']) && (request.auth.uid in resource.data.sellerUids || ('profile_' + request.auth.uid) in resource.data.sellerUids)) ||
        isMarketplaceModerator()
      );
      allow create: if isSignedIn() && (
        request.resource.data.buyerUid == request.auth.uid ||
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.buyerId == ('profile_' + request.auth.uid)
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          !incoming().diff(existing()).affectedKeys().hasAny([
            'price', 'total', 'amount', 'sellerUid', 'sellerId', 'buyerUid', 'buyerId', 'currency', 'items', 'paymentMethod', 'transactionId'
          ]) && (
            // Seller updates fulfillment status, shipping tracking, and refund resolution
            (
              (resource.data.sellerUid == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.sellerId == ('profile_' + request.auth.uid) || (resource.data.keys().hasAll(['sellerUids']) && (request.auth.uid in resource.data.sellerUids || ('profile_' + request.auth.uid) in resource.data.sellerUids))) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['currentStatus', 'status', 'trackingTimeline', 'trackingNumber', 'notes', 'sellerNotes', 'fulfillmentStatus', 'refundStatus', 'refundReason', 'refundNotes', 'refundDecisionDate', 'resolution', 'updatedAt'])
            ) ||
            // Buyer updates cancellation or refund notes
            (
              (resource.data.buyerUid == request.auth.uid || resource.data.buyerId == request.auth.uid || resource.data.buyerId == ('profile_' + request.auth.uid)) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['currentStatus', 'status', 'refundStatus', 'refundReason', 'customerNotes', 'buyerNotes', 'cancellationReason', 'rating', 'review', 'updatedAt'])
            )
          )
        )
      );
      allow delete: if isAdmin();
    }

    // 37. LOGIN SESSIONS: User owner or admin only
    match /login_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 38. CONTENT REPORTS: Reporter or moderator only
    match /reports/{reportId} {
      allow read: if isModerator() || (
        isSignedIn() && resource != null && (
          (resource.data.keys().hasAll(['reporterUid']) && resource.data.reporterUid == request.auth.uid) ||
          (resource.data.keys().hasAll(['reporterId']) && (resource.data.reporterId == request.auth.uid || resource.data.reporterId == ('profile_' + request.auth.uid)))
        )
      );
      allow create: if isSignedIn()
        && (
          (request.resource.data.keys().hasAll(['reporterUid']) && request.resource.data.reporterUid == request.auth.uid) ||
          (request.resource.data.keys().hasAll(['reporterId']) && (request.resource.data.reporterId == request.auth.uid || request.resource.data.reporterId == ('profile_' + request.auth.uid)))
        )
        && request.resource.data.status == 'pending';
      allow update, delete: if isModerator();
    }

    // 39. SYSTEM CONFIGURATION: Public read; admin only write (Moderators/Support CANNOT write)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 40. GROUPS & PAGES: Owner/creator only write
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.creatorUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid ||
        isModerator()
      );
    }
    
    match /pages/{pageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.creatorUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid ||
        isModerator()
      );
    }

    // 41. APPEALS & MODERATION: Appellant or moderator only
    match /appeals/{appealId} {
      allow read: if isModerator() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isModerator();
    }

    // 42. MARKETPLACE ITEMS: Public read; seller/owner or marketplace moderator write
    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerUid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.sellerUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        isMarketplaceModerator()
      );
    }

    // 43. LOGS & EVENTS: Owner or admin only
    match /login_history/{historyId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /processed_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /transaction_logs/{logId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 44. SUPPORT REPORTS: Reporter or support role only
    match /supportReports/{reportId} {
      allow read: if isSupport() || (
        isSignedIn() && resource != null && (
          (resource.data.keys().hasAll(['userUid']) && resource.data.userUid == request.auth.uid) ||
          (resource.data.keys().hasAll(['userId']) && resource.data.userId == request.auth.uid)
        )
      );
      allow create: if isSignedIn()
        && (
          (request.resource.data.keys().hasAll(['userUid']) && request.resource.data.userUid == request.auth.uid) ||
          (request.resource.data.keys().hasAll(['userId']) && request.resource.data.userId == request.auth.uid)
        )
        && (request.resource.data.status == 'Pending' || request.resource.data.status == 'pending' || !request.resource.data.keys().hasAll(['status']));
      allow update: if isSupport() || (
        isSignedIn() && resource != null && (
          (resource.data.keys().hasAll(['userUid']) && resource.data.userUid == request.auth.uid) ||
          (resource.data.keys().hasAll(['userId']) && resource.data.userId == request.auth.uid)
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'priority', 'adminReply', 'closedAt', 'userUid', 'userId'])
      );
      allow delete: if isSupport();
    }

    // 45. SUPPORT TICKETS: Reporter or support role only (FeedbackSettings)
    match /supportTickets/{ticketId} {
      allow read: if isSupport() || (
        isSignedIn() && resource != null && resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.status == 'open' || !request.resource.data.keys().hasAll(['status']));
      allow update: if isSupport() || (
        isSignedIn() && resource != null && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'userId'])
      );
      allow delete: if isSupport();
    }
  }
}
